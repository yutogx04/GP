# MedIntern Backend Environment Configuration
# Copy this file to .env and fill in your values

# Security
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default is SQLite, configure for PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/medintern

# Email Configuration
# For development, emails are printed to console by default
# For production, configure SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MedIntern <noreply@medintern.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# CORS (for production, list allowed origins)
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Celery (for background tasks like reminders)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to False in production when Redis is available
CELERY_TASK_ALWAYS_EAGER=True
